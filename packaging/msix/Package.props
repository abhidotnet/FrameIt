<Project>
  <PropertyGroup>
    <!-- One place for the package version and the Store identity.
         Version is four parts and is also the assembly version.
         After Partner Center reserves the name, replace IdentityName, Publisher,
         and PublisherDisplayName with the Product identity values. Leave DisplayName as FrameIt
         unless the reserved Store listing name is different.
         Publisher must be the certificate subject, including the CN= prefix.
         SideloadPublisher matches dist/FrameIt-Test-Certificate.cer and is selected by build.ps1 -MsixSideload. -->
    <Version>0.4.0.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0-beta</InformationalVersion>
    <FrameItIdentityName>FrameIt.Placeholder</FrameItIdentityName>
    <FrameItPublisher>CN=FrameIt Publisher Placeholder</FrameItPublisher>
    <FrameItPublisherDisplayName>FrameIt Publisher Placeholder</FrameItPublisherDisplayName>
    <FrameItDisplayName>FrameIt</FrameItDisplayName>
    <FrameItSideloadPublisher>CN=Abhijit Shrikhande (FrameIt Test)</FrameItSideloadPublisher>
  </PropertyGroup>
</Project>
