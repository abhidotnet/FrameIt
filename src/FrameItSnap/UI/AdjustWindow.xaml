<Window
    x:Class="FrameItSnap.UI.AdjustWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Brightness and contrast"
    Icon="/Assets/FrameIt-256.png"
    Width="420"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" x:Name="BrightnessValue" Width="40" TextAlignment="Right" Text="0" />
            <TextBlock VerticalAlignment="Center" Text="Brightness" />
        </DockPanel>
        <Slider x:Name="BrightnessSlider" Grid.Row="1" Minimum="-100" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12" />

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" x:Name="ContrastValue" Width="40" TextAlignment="Right" Text="0" />
            <TextBlock VerticalAlignment="Center" Text="Contrast" />
        </DockPanel>
        <Slider x:Name="ContrastSlider" Grid.Row="3" Minimum="-100" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="88" Margin="0,0,8,0" Content="Reset" Click="Reset_OnClick" />
            <Button Width="88" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
            <Button Width="88" IsDefault="True" Content="Apply" Click="Apply_OnClick" />
        </StackPanel>
    </Grid>
</Window>
