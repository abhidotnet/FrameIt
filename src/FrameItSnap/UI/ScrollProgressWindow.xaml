<Window
    x:Class="FrameItSnap.UI.ScrollProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameIt Snap"
    Icon="/Assets/FrameIt-256.png"
    Width="240"
    Height="118"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    UseLayoutRounding="True">
    <Border Background="#F21E1E1E" CornerRadius="10" Padding="14,12" BorderBrush="#66FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock
                Text="Scrolling capture"
                FontFamily="Segoe UI"
                FontWeight="SemiBold"
                Foreground="White" />
            <TextBlock
                x:Name="DetailText"
                Margin="0,6,0,0"
                Text="Starting"
                FontFamily="Segoe UI"
                Foreground="#FFE0E0E0" />
            <TextBlock
                Text="Esc to stop"
                Margin="0,2,0,8"
                FontFamily="Segoe UI"
                FontSize="12"
                Foreground="#FFBDBDBD" />
            <Button
                x:Name="StopButton"
                Width="88"
                HorizontalAlignment="Left"
                Content="Stop"
                IsCancel="True"
                Click="StopButton_OnClick" />
        </StackPanel>
    </Border>
</Window>
