<Window
    x:Class="FrameItSnap.UI.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameIt Snap"
    Icon="/Assets/FrameIt-256.png"
    Width="220"
    Height="132"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    Focusable="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    UseLayoutRounding="True">
    <Border Background="#F21E1E1E" CornerRadius="12" Padding="18,14" BorderBrush="#66FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock
                x:Name="CountText"
                Text="0"
                FontFamily="Segoe UI"
                FontSize="42"
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="DetailText"
                Text="Capturing soon"
                FontFamily="Segoe UI"
                Foreground="#FFE0E0E0"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Esc to cancel"
                FontFamily="Segoe UI"
                Foreground="#FFBDBDBD"
                HorizontalAlignment="Center"
                Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
