<Window
    x:Class="FrameIt.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameIt Settings"
    Width="700"
    Height="680"
    MinWidth="640"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Capture">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="Capture folder" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,12">
                            <Button x:Name="BrowseFolderButton" Width="96" Margin="8,0,0,0" DockPanel.Dock="Right" Click="BrowseFolderButton_OnClick">Browse</Button>
                            <TextBox x:Name="CaptureFolderTextBox" />
                        </DockPanel>

                        <TextBlock Text="Fixed-size region (pixels)" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <TextBlock VerticalAlignment="Center" Text="Width" Margin="0,0,8,0" />
                            <TextBox x:Name="FixedWidthTextBox" Width="100" Margin="0,0,16,0" />
                            <TextBlock VerticalAlignment="Center" Text="Height" Margin="0,0,8,0" />
                            <TextBox x:Name="FixedHeightTextBox" Width="100" />
                        </StackPanel>

                        <TextBlock Text="Capture delay (seconds, 0–10)" FontWeight="SemiBold" />
                        <TextBox x:Name="CaptureDelayTextBox" Width="80" HorizontalAlignment="Left" Margin="0,8,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,12"
                                   Text="FrameIt waits this long before every capture so you can switch windows. A countdown is shown and the tray icon reads the remaining seconds. Esc cancels. 0 captures immediately. The same choices are on the tray menu." />

                        <CheckBox x:Name="TimingLogsCheckBox" Content="Enable local timing logs (no image data)" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoSaveCheckBox" Content="Auto-save captures as PNG (capture-YYYYMMDD-HHmmss.png)" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock VerticalAlignment="Center" Text="JPEG quality (1–100)" Margin="0,0,8,0" />
                            <TextBox x:Name="JpegQualityTextBox" Width="80" />
                        </StackPanel>

                        <GroupBox Header="Global hotkeys">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Region capture</TextBlock>
                                <TextBox x:Name="RegionHotkeyTextBox" Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Full screen</TextBlock>
                                <TextBox x:Name="FullScreenHotkeyTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Active window</TextBlock>
                                <TextBox x:Name="ActiveWindowHotkeyTextBox" Grid.Row="2" Grid.Column="1" Margin="8,4,0,4" />
                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Fixed-size region</TextBlock>
                                <TextBox x:Name="FixedRegionHotkeyTextBox" Grid.Row="3" Grid.Column="1" Margin="8,4,0,4" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Email">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Share → Email sends the flattened image to the default To address. It does not ask for a subject or recipient." />
                        <TextBlock x:Name="SmtpSecurityNote" TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,12"
                                   Text="The password is stored in Windows Credential Manager, not in settings.json. Leave the password box blank to keep the saved secret. Check remove, with the box blank, to delete it. If Username is blank, FrameIt signs in with the From address." />

                        <TextBlock Text="Host" />
                        <TextBox x:Name="SmtpHostTextBox" Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock VerticalAlignment="Center" Text="Port" Margin="0,0,8,0" />
                            <TextBox x:Name="SmtpPortTextBox" Width="80" Margin="0,0,16,0" />
                            <TextBlock VerticalAlignment="Center" Text="Security" Margin="0,0,8,0" />
                            <ComboBox x:Name="SmtpSecurityCombo" Width="160" />
                        </StackPanel>

                        <TextBlock Text="Username" />
                        <TextBox x:Name="SmtpUsernameTextBox" Margin="0,4,0,8" />

                        <TextBlock Text="From address" />
                        <TextBox x:Name="SmtpFromTextBox" Margin="0,4,0,8" />

                        <TextBlock Text="Default To address" />
                        <TextBox x:Name="SmtpToTextBox" Margin="0,4,0,8" ToolTip="One address, or several separated by commas." />

                        <TextBlock Text="Password" />
                        <PasswordBox x:Name="SmtpPasswordBox" Margin="0,4,0,4" />
                        <TextBlock x:Name="SmtpStoredText" TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,4" />
                        <CheckBox x:Name="SmtpRemoveCheckBox" Content="Remove saved password" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Upload">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,12"
                                   Text="Passwords and passphrases are stored in Windows Credential Manager, not in settings.json. Leave a box blank to keep the saved secret. Check remove, with the box blank, to delete it. Switching SFTP auth mode does not delete the other saved secret." />

                        <GroupBox Header="FTP" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,8"
                                           Text="Share → Upload (FTP) uses the built-in FTP client in passive binary mode. The password is not stored in settings.json." />
                                <TextBlock Text="Host" />
                                <TextBox x:Name="FtpHostTextBox" Margin="0,4,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock VerticalAlignment="Center" Text="Port" Margin="0,0,8,0" />
                                    <TextBox x:Name="FtpPortTextBox" Width="80" />
                                </StackPanel>
                                <TextBlock Text="Remote path" />
                                <TextBox x:Name="FtpPathTextBox" Margin="0,4,0,8" />
                                <TextBlock Text="Username" />
                                <TextBox x:Name="FtpUsernameTextBox" Margin="0,4,0,8" />
                                <TextBlock Text="Password" />
                                <PasswordBox x:Name="FtpPasswordBox" Margin="0,4,0,4" />
                                <TextBlock x:Name="FtpStoredText" TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,4" />
                                <CheckBox x:Name="FtpRemoveCheckBox" Content="Remove saved password" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="SFTP">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="SftpNoticeText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="Host" />
                                <TextBox x:Name="SftpHostTextBox" Margin="0,4,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock VerticalAlignment="Center" Text="Port" Margin="0,0,8,0" />
                                    <TextBox x:Name="SftpPortTextBox" Width="80" Margin="0,0,16,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Authentication" Margin="0,0,8,0" />
                                    <ComboBox x:Name="SftpAuthCombo" Width="160" SelectionChanged="SftpAuthCombo_OnSelectionChanged" />
                                </StackPanel>
                                <TextBlock Text="Remote path" />
                                <TextBox x:Name="SftpPathTextBox" Margin="0,4,0,8" />
                                <TextBlock Text="Username" />
                                <TextBox x:Name="SftpUsernameTextBox" Margin="0,4,0,8" />

                                <StackPanel x:Name="SftpPasswordPanel">
                                    <TextBlock Text="Password" />
                                    <PasswordBox x:Name="SftpPasswordBox" Margin="0,4,0,4" />
                                    <TextBlock x:Name="SftpPasswordStoredText" TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,4" />
                                    <CheckBox x:Name="SftpRemovePasswordCheckBox" Content="Remove saved password" />
                                </StackPanel>

                                <StackPanel x:Name="SftpKeyPanel" Margin="0,8,0,0">
                                    <TextBlock Text="Private key path" />
                                    <DockPanel Margin="0,4,0,8">
                                        <Button x:Name="SftpBrowseKeyButton" Width="96" Margin="8,0,0,0" DockPanel.Dock="Right" Click="SftpBrowseKeyButton_OnClick">Browse</Button>
                                        <TextBox x:Name="SftpKeyPathTextBox" />
                                    </DockPanel>
                                    <TextBlock Text="Key passphrase" />
                                    <PasswordBox x:Name="SftpPassphraseBox" Margin="0,4,0,4" />
                                    <TextBlock x:Name="SftpPassphraseStoredText" TextWrapping="Wrap" Foreground="#444444" Margin="0,0,0,4" />
                                    <CheckBox x:Name="SftpRemovePassphraseCheckBox" Content="Remove saved passphrase" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="96" Margin="0,0,8,0" Click="CancelButton_OnClick" IsCancel="True">Cancel</Button>
            <Button Width="120" Click="SaveButton_OnClick" IsDefault="True">Save settings</Button>
        </StackPanel>
    </Grid>
</Window>
