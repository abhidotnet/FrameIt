<Window
    x:Class="FrameIt.UI.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameIt Viewer"
    Width="1000"
    Height="700"
    Background="#101010"
    KeyDown="OnKeyDown">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="10" Background="#1E1E1E">
                <TextBlock x:Name="PathLabel" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Image x:Name="CapturedImage" Stretch="None" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
