<Window
    x:Class="FrameIt.UI.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameIt Editor"
    Icon="/Assets/FrameIt-256.png"
    Width="1100"
    Height="760"
    MinWidth="760"
    MinHeight="520"
    Background="#F3F3F3"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    KeyboardNavigation.ControlTabNavigation="None">
    <Window.Resources>
        <Style x:Key="RibbonToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2,4,2,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E5F1FB" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C2D9EE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#D0E7F8" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7EB4EA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2,4,2,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E5F1FB" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C2D9EE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#D0E7F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#6E6E6E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6,6,6,4">
                <StackPanel x:Name="ToolsPanel" Orientation="Horizontal">
                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Style="{StaticResource RibbonButton}" ToolTip="Copy the flattened image (Ctrl+C)" Click="Copy_OnClick">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE8C8;" />
                                <TextBlock Style="{StaticResource RibbonLabel}" Text="Copy" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Row="1" Style="{StaticResource GroupCaption}" Text="Clipboard" />
                    </Grid>

                    <Border Width="1" Background="#E0E0E0" Margin="0,4,8,16" />

                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" ToolTip="Brightness and contrast" Click="Adjust_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE706;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Effects" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" ToolTip="Resize by pixels or percent" Click="Resize_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="#242424" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Resize" />
                                </StackPanel>
                            </Button>
                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Padding="0" ToolTip="Rotate or flip">
                                    <MenuItem.Header>
                                        <StackPanel Width="54" Height="52">
                                            <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE7AD;" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Rotate" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem Header="Rotate left" ToolTip="Rotate 90° left" Click="RotateLeft_OnClick" />
                                    <MenuItem Header="Rotate right" ToolTip="Rotate 90° right" Click="RotateRight_OnClick" />
                                    <MenuItem Header="Flip horizontal" ToolTip="Flip horizontal" Click="FlipHorizontal_OnClick" />
                                    <MenuItem Header="Flip vertical" ToolTip="Flip vertical" Click="FlipVertical_OnClick" />
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource GroupCaption}" Text="Image" />
                    </Grid>

                    <Border Width="1" Background="#E0E0E0" Margin="0,4,8,16" />

                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="SelectToolButton" Style="{StaticResource RibbonToggle}" Tag="Select" IsChecked="True" ToolTip="Move, select, or delete an annotation" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Path Fill="#242424" Data="M3,1 L3,13 L6.2,9.6 L8.6,14 L10.4,13.1 L8,8.8 L12.2,8.8 Z" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Move" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Crop" ToolTip="Drag a rectangle to crop. The bright area is kept." Click="ToolButton_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE7A8;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Crop" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Arrow" ToolTip="Drag to draw an arrow" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="#242424" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,13 L13,2 M13,2 H8 M13,2 V7" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Arrow" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Line" ToolTip="Drag to draw a line" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="#242424" StrokeThickness="1.4" StrokeStartLineCap="Round" Data="M2,13 L14,3" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Line" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Pen" ToolTip="Draw freehand" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE70F;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Draw" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Highlighter" ToolTip="Draw a translucent highlighter stroke" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE7E6;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Mark" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Text" ToolTip="Click to place text. Double-click existing text to edit it." Click="ToolButton_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE8D2;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Text" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Rectangle" ToolTip="Drag to draw a rectangle" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Rectangle Canvas.Left="2" Canvas.Top="3" Width="12" Height="10" Stroke="#242424" StrokeThickness="1.4" Fill="Transparent" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Rect" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Ellipse" ToolTip="Drag to draw an ellipse" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Ellipse Canvas.Left="2" Canvas.Top="3" Width="12" Height="10" Stroke="#242424" StrokeThickness="1.4" Fill="Transparent" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Oval" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Step" ToolTip="Click to drop the next numbered step" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Fill="#242424" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Step" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Blur" ToolTip="Drag a rectangle to blur it" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="#242424" StrokeThickness="1.4" StrokeStartLineCap="Round" Data="M2,5 H14 M2,8 H14 M2,11 H14" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Blur" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource RibbonToggle}" Tag="Pixelate" ToolTip="Drag a rectangle to pixelate it" Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="5" Height="5" Fill="#242424" />
                                            <Rectangle Canvas.Left="9" Canvas.Top="2" Width="5" Height="5" Fill="#242424" />
                                            <Rectangle Canvas.Left="2" Canvas.Top="9" Width="5" Height="5" Fill="#242424" />
                                            <Rectangle Canvas.Left="9" Canvas.Top="9" Width="5" Height="5" Fill="#242424" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Pixel" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource GroupCaption}" Text="Tools" />
                    </Grid>

                    <Border Width="1" Background="#E0E0E0" Margin="0,4,8,16" />

                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Width="168" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thick" FontSize="11" VerticalAlignment="Center" />
                            <Slider x:Name="ThicknessSlider" Grid.Column="1" Minimum="1" Maximum="32" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="ThicknessValue" Grid.Column="2" Text="3" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="Font" FontSize="11" VerticalAlignment="Center" />
                            <Slider x:Name="FontSlider" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="72" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="FontValue" Grid.Row="1" Grid.Column="2" Text="18" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Text="Strength" FontSize="11" VerticalAlignment="Center" ToolTip="Blur or pixelate strength" />
                            <Slider x:Name="StrengthSlider" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="Blur or pixelate strength" />
                            <TextBlock x:Name="StrengthValue" Grid.Row="2" Grid.Column="2" Text="8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource GroupCaption}" Text="Size" />
                    </Grid>

                    <Border Width="1" Background="#E0E0E0" Margin="0,4,8,16" />

                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="Color1Button" Width="32" Height="32" Margin="2,0" BorderBrush="#242424" BorderThickness="2" ToolTip="Color 1, the color used for new shapes. Click again for a custom color." Click="ColorWell_OnClick" Tag="0" />
                            <Button x:Name="Color2Button" Width="24" Height="24" Margin="2,0" BorderBrush="#B0B0B0" BorderThickness="1" ToolTip="Color 2. Click to draw with this color instead." Click="ColorWell_OnClick" Tag="1" />
                            <ToggleButton Style="{StaticResource RibbonToggle}" Width="46" Tag="Eyedropper" ToolTip="Eyedropper. Click the image to pick a color into the active well." Click="ToolButton_OnClick">
                                <StackPanel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="16" Height="16">
                                            <Path Fill="#242424" Data="M10,2 L14,6 L7,13 L3,13 L3,9 Z M2,14 H6" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Pick" />
                                </StackPanel>
                            </ToggleButton>
                            <WrapPanel x:Name="ColorPalette" Width="80" Margin="4,0,0,0" />
                            <Button x:Name="CustomColorButton" Style="{StaticResource RibbonButton}" Width="46" ToolTip="Pick a custom annotation color" Click="CustomColor_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE790;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="More" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource GroupCaption}" Text="Colors" />
                    </Grid>

                    <Border Width="1" Background="#E0E0E0" Margin="0,4,8,16" />

                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UndoButton" Style="{StaticResource RibbonButton}" ToolTip="Undo (Ctrl+Z)" Click="Undo_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE7A7;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Undo" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RedoButton" Style="{StaticResource RibbonButton}" ToolTip="Redo (Ctrl+Y)" Click="Redo_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE7A6;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Redo" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" ToolTip="Save (Ctrl+S)" Click="Save_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE74E;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Save" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonButton}" ToolTip="Save As (Ctrl+Shift+S)" Click="SaveAs_OnClick">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE792;" />
                                    <TextBlock Style="{StaticResource RibbonLabel}" Text="Save as" />
                                </StackPanel>
                            </Button>
                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Padding="0" ToolTip="Send the flattened image">
                                    <MenuItem.Header>
                                        <StackPanel Width="54" Height="52">
                                            <TextBlock Style="{StaticResource RibbonGlyph}" Text="&#xE72D;" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Share" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem Header="Email" ToolTip="Email the flattened image through the SMTP server in Settings" Click="ShareEmail_OnClick" />
                                    <MenuItem Header="Upload (FTP)" ToolTip="Upload the flattened image to the FTP server in Settings" Click="ShareFtp_OnClick" />
                                    <MenuItem Header="Upload (SFTP)" ToolTip="SFTP needs an SSH library and is not available in this build" Click="ShareSftp_OnClick" />
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource GroupCaption}" Text="File" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="RestoreNoticeBar"
            DockPanel.Dock="Top"
            Visibility="Collapsed"
            Background="#FFF4D6"
            BorderBrush="#E6D7A2"
            BorderThickness="0,0,0,1"
            Cursor="Hand"
            MouseLeftButtonUp="RestoreNoticeBar_OnMouseLeftButtonUp">
            <TextBlock x:Name="RestoreNoticeText" Margin="10,6" TextTrimming="CharacterEllipsis" />
        </Border>

        <Border DockPanel.Dock="Top" Background="#ECECEC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <Grid DockPanel.Dock="Bottom" Background="#F7F7F7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Margin="10,6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                <TextBlock Text="JPEG quality" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="JpegQualityTextBox" Width="48" ToolTip="1–100. Used when saving JPEG. Default 90." LostFocus="JpegQualityTextBox_OnLostFocus" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Background="#2B2B2B"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
            Focusable="False">
            <Grid
                x:Name="CanvasHost"
                Margin="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
                <Image
                    x:Name="BaseImage"
                    Stretch="Fill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    SnapsToDevicePixels="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="RedactionCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="ShapeCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="OverlayCanvas">
                    <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False" />
                    <TextBox
                        x:Name="InlineTextBox"
                        Visibility="Collapsed"
                        MinWidth="140"
                        MaxWidth="420"
                        Padding="4,2"
                        FontFamily="Segoe UI"
                        Background="White"
                        LostFocus="InlineTextBox_OnLostFocus"
                        PreviewKeyDown="InlineTextBox_OnPreviewKeyDown" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
