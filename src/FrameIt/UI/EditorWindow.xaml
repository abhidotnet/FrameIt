<Window
    x:Class="FrameIt.UI.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameIt Editor"
    Width="1100"
    Height="760"
    MinWidth="760"
    MinHeight="520"
    Background="#F3F3F3"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinWidth" Value="52" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinWidth" Value="52" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,8,8,4" Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <WrapPanel x:Name="ToolsPanel">
                <ToggleButton x:Name="SelectToolButton" Content="Select" Tag="Select" IsChecked="True" ToolTip="Select, move, or delete an annotation" Click="ToolButton_OnClick" />
                <ToggleButton Content="Crop" Tag="Crop" ToolTip="Drag a rectangle to crop" Click="ToolButton_OnClick" />
                <ToggleButton Content="Arrow" Tag="Arrow" ToolTip="Drag to draw an arrow" Click="ToolButton_OnClick" />
                <ToggleButton Content="Line" Tag="Line" ToolTip="Drag to draw a line" Click="ToolButton_OnClick" />
                <ToggleButton Content="Rect" Tag="Rectangle" ToolTip="Drag to draw a rectangle" Click="ToolButton_OnClick" />
                <ToggleButton Content="Ellipse" Tag="Ellipse" ToolTip="Drag to draw an ellipse" Click="ToolButton_OnClick" />
                <ToggleButton Content="Pen" Tag="Pen" ToolTip="Draw freehand" Click="ToolButton_OnClick" />
                <ToggleButton Content="Highlight" Tag="Highlighter" ToolTip="Draw a translucent highlighter stroke" Click="ToolButton_OnClick" />
                <ToggleButton Content="Text" Tag="Text" ToolTip="Click to place text. Double-click existing text to edit it." Click="ToolButton_OnClick" />
                <ToggleButton Content="Step" Tag="Step" ToolTip="Click to drop the next numbered step" Click="ToolButton_OnClick" />
                <ToggleButton Content="Blur" Tag="Blur" ToolTip="Drag a rectangle to blur it" Click="ToolButton_OnClick" />
                <ToggleButton Content="Pixelate" Tag="Pixelate" ToolTip="Drag a rectangle to pixelate it" Click="ToolButton_OnClick" />

                <Border Width="1" Height="22" Background="#CCCCCC" Margin="6,2,8,6" />
                <StackPanel x:Name="ColorPalette" Orientation="Horizontal" />
                <Button x:Name="CustomColorButton" Content="Custom" ToolTip="Pick a custom annotation color" Click="CustomColor_OnClick" />

                <Border Width="1" Height="22" Background="#CCCCCC" Margin="6,2,8,6" />
                <TextBlock Text="Thick" VerticalAlignment="Center" Margin="0,0,4,4" />
                <Slider x:Name="ThicknessSlider" Width="90" Minimum="1" Maximum="32" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,4,4" />
                <TextBlock x:Name="ThicknessValue" Text="3" Width="22" VerticalAlignment="Center" Margin="0,0,8,4" />
                <TextBlock Text="Font" VerticalAlignment="Center" Margin="0,0,4,4" />
                <Slider x:Name="FontSlider" Width="90" Minimum="8" Maximum="72" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,4,4" />
                <TextBlock x:Name="FontValue" Text="18" Width="22" VerticalAlignment="Center" Margin="0,0,8,4" />
                <TextBlock Text="Strength" VerticalAlignment="Center" Margin="0,0,4,4" ToolTip="Blur or pixelate strength" />
                <Slider x:Name="StrengthSlider" Width="90" Minimum="1" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,4,4" ToolTip="Blur or pixelate strength" />
                <TextBlock x:Name="StrengthValue" Text="8" Width="22" VerticalAlignment="Center" Margin="0,0,8,4" />

                <Border Width="1" Height="22" Background="#CCCCCC" Margin="6,2,8,6" />
                <Button Content="Rotate L" ToolTip="Rotate 90° left" Click="RotateLeft_OnClick" />
                <Button Content="Rotate R" ToolTip="Rotate 90° right" Click="RotateRight_OnClick" />
                <Button Content="Flip H" ToolTip="Flip horizontal" Click="FlipHorizontal_OnClick" />
                <Button Content="Flip V" ToolTip="Flip vertical" Click="FlipVertical_OnClick" />
                <Button Content="Resize" ToolTip="Resize by pixels or percent" Click="Resize_OnClick" />
                <Button Content="Brightness" ToolTip="Brightness and contrast" Click="Adjust_OnClick" />

                <Border Width="1" Height="22" Background="#CCCCCC" Margin="6,2,8,6" />
                <Button x:Name="UndoButton" Content="Undo" ToolTip="Undo (Ctrl+Z)" Click="Undo_OnClick" />
                <Button x:Name="RedoButton" Content="Redo" ToolTip="Redo (Ctrl+Y)" Click="Redo_OnClick" />
                <Button Content="Copy" ToolTip="Copy the flattened image (Ctrl+C)" Click="Copy_OnClick" />
                <Button Content="Save" ToolTip="Save (Ctrl+S)" Click="Save_OnClick" />
                <Button Content="Save As" ToolTip="Save As (Ctrl+Shift+S)" Click="SaveAs_OnClick" />
            </WrapPanel>
        </Border>

        <Grid DockPanel.Dock="Bottom" Background="#F7F7F7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Margin="10,6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                <TextBlock Text="JPEG quality" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="JpegQualityTextBox" Width="48" ToolTip="1–100. Used when saving JPEG. Default 90." LostFocus="JpegQualityTextBox_OnLostFocus" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Background="#2B2B2B"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
            Focusable="False">
            <Grid
                x:Name="CanvasHost"
                Margin="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
                <Image
                    x:Name="BaseImage"
                    Stretch="Fill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    SnapsToDevicePixels="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="RedactionCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="ShapeCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="OverlayCanvas">
                    <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False" />
                    <TextBox
                        x:Name="InlineTextBox"
                        Visibility="Collapsed"
                        MinWidth="140"
                        MaxWidth="420"
                        Padding="4,2"
                        FontFamily="Segoe UI"
                        Background="White"
                        LostFocus="InlineTextBox_OnLostFocus"
                        PreviewKeyDown="InlineTextBox_OnPreviewKeyDown" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
